    "viewsContainers": {
      "activitybar": [
        {
          "id": "corgi",
          "title": "Corgi",
          "icon": "resources/activityBarIcon.png"
        }
      ]
    },
    "views": {
      "corgi": [
        {
          "id": "corgiTreeView",
          "name": "Woof"
        },
        {
          "id": "corgiWatchInbox",
          "name": "Inbox",
          "contextualTitle": "Corgi watch inbox"
        },
        {
          "id": "corgiAgentSessions",
          "name": "Agent sessions",
          "contextualTitle": "Corgi agent sessions"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "corgi.run",
          "group": "navigation",
          "when": "resourceFilename =~ /corgi-*.*\\.y(a)?ml/"
        },
        {
          "command": "corgi.stop",
          "group": "navigation",
          "when": "resourceFilename =~ /corgi-*.*\\.y(a)?ml/"
        }
      ],
      "view/title": [
        {
          "command": "corgi.runFromRoot",
          "when": "view == corgiTreeView",
          "group": "navigation"
        },
        {
          "command": "corgi.stop",
          "when": "view == corgiTreeView",
          "group": "navigation"
        },
        {
          "command": "corgi.reload",
          "when": "view == corgiTreeView",
          "group": "navigation"
        },
        {
          "command": "corgi.agent.new",
          "when": "view == corgiAgentSessions",
          "group": "navigation"
        },
        {
          "command": "corgi.agent.openBot",
          "when": "view == corgiAgentSessions",
          "group": "navigation"
        },
        {
          "command": "corgi.agent.ask",
          "when": "view == corgiAgentSessions",
          "group": "navigation"
        },
        {
          "command": "corgi.agent.inboxRefresh",
          "when": "view == corgiWatchInbox",
          "group": "navigation"
        },
        {
          "command": "corgi.agent.refresh",
          "when": "view == corgiAgentSessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "corgi.runExample",
          "when": "view == corgiTreeView && viewItem == example"
        },
        {
          "command": "corgi.downloadExample",
          "when": "view == corgiTreeView && viewItem == example"
        },
        {
          "command": "corgi.openLink",
          "when": "view == corgiTreeView && viewItem == example"
        },
        {
          "command": "corgi.forkExample",
          "when": "view == corgiTreeView && viewItem == example"
        },
        {
          "command": "corgi.agent.answer",
          "when": "view == corgiAgentSessions && viewItem == corgiAgentSessionPending",
          "group": "inline@1"
        },
        {
          "command": "corgi.agent.deny",
          "when": "view == corgiAgentSessions && viewItem == corgiAgentSessionPending",
          "group": "inline@2"
        },
        {
          "command": "corgi.agent.note",
          "when": "view == corgiAgentSessions && viewItem =~ /corgiAgentSession/",
          "group": "1_edit@1"
        },
        {
          "command": "corgi.agent.dismiss",
          "when": "view == corgiAgentSessions && viewItem =~ /corgiAgentSession/",
          "group": "1_edit@2"
        },
        {
          "command": "corgi.agent.interrupt",
          "when": "view == corgiAgentSessions && viewItem =~ /corgiAgentSession.*Working/",
          "group": "0_answer@3"
        },
        {
          "command": "corgi.agent.always",
          "when": "view == corgiAgentSessions && viewItem =~ /Pending/",
          "group": "0_answer@1"
        },
        {
          "command": "corgi.agent.sendTo",
          "when": "view == corgiAgentSessions && viewItem =~ /corgiAgentSession/",
          "group": "1_edit@0"
        },
        {
          "command": "corgi.agent.fresh",
          "when": "view == corgiAgentSessions && viewItem =~ /corgiAgentSession/",
          "group": "1_edit@3"
        },
        {
          "command": "corgi.agent.openPr",
          "when": "view == corgiAgentSessions && viewItem =~ /Pr/",
          "group": "2_open@1"
        },
        {
          "command": "corgi.agent.copyId",
          "when": "view == corgiAgentSessions && viewItem =~ /corgiAgentSession/",
          "group": "3_copy@1"
        },
        {
          "command": "corgi.agent.hideWorkspace",
          "when": "view == corgiAgentSessions && viewItem == corgiAgentGroup",
          "group": "1_edit@1"
        },
        {
          "command": "corgi.agent.inboxOpen",
          "when": "view == corgiWatchInbox && viewItem =~ /corgiInboxItem/",
          "group": "0_open@1"
        },
        {
          "command": "corgi.agent.inboxWorkOn",
          "when": "view == corgiWatchInbox && viewItem =~ /corgiInboxItem.*Issue/",
          "group": "inline@0"
        },
        {
          "command": "corgi.agent.inboxWorkOn",
          "when": "view == corgiWatchInbox && viewItem =~ /corgiInboxItem.*Issue/",
          "group": "0_open@0"
        },
        {
          "command": "corgi.agent.inboxWorkOnIsolated",
          "when": "view == corgiWatchInbox && viewItem =~ /corgiInboxItem.*Issue/",
          "group": "0_open@2"
        },
        {
          "command": "corgi.agent.inboxUnblock",
          "when": "view == corgiWatchInbox && viewItem =~ /corgiInboxItemBlocked/",
          "group": "1_act@0"
        },
        {
          "command": "corgi.agent.inboxPrReady",
          "when": "view == corgiWatchInbox && viewItem =~ /corgiInboxItem.*Pr/",
          "group": "1_pr@0"
        },
        {
          "command": "corgi.agent.inboxPrMerge",
          "when": "view == corgiWatchInbox && viewItem =~ /corgiInboxItem.*Pr/",
          "group": "1_pr@1"
        },
        {
          "command": "corgi.agent.inboxPrClose",
          "when": "view == corgiWatchInbox && viewItem =~ /corgiInboxItem.*Pr/",
          "group": "1_pr@2"
        },
        {
          "command": "corgi.agent.inboxAssign",
          "when": "view == corgiWatchInbox && viewItem =~ /corgiInboxItem/",
          "group": "1_act@1"
        },
        {
          "command": "corgi.agent.inboxMove",
          "when": "view == corgiWatchInbox && viewItem =~ /corgiInboxItem/",
          "group": "1_act@2"
        },
        {
          "command": "corgi.agent.inboxIgnore",
          "when": "view == corgiWatchInbox && viewItem =~ /corgiInboxItem/",
          "group": "inline@1"
        },
        {
          "command": "corgi.agent.inboxIgnore",
          "when": "view == corgiWatchInbox && viewItem =~ /corgiInboxItem/",
          "group": "2_gone@1"
        }
      ],
      "commandPalette": [
        {
          "command": "corgi.agent.focusNode",
          "when": "false"
        },
        {
          "command": "corgi.agent.answer",
          "when": "false"
        },
        {
          "command": "corgi.agent.deny",
          "when": "false"
        },
        {
          "command": "corgi.agent.always",
          "when": "false"
        },
        {
          "command": "corgi.agent.openPr",
          "when": "false"
        },
        {
          "command": "corgi.agent.copyId",
          "when": "false"
        },
        {
          "command": "corgi.agent.inboxOpen",
          "when": "false"
        },
        {
          "command": "corgi.agent.inboxWorkOn",
          "when": "false"
        },
        {
          "command": "corgi.agent.inboxWorkOnIsolated",
          "when": "false"
        },
        {
          "command": "corgi.agent.inboxPrReady",
          "when": "false"
        },
        {
          "command": "corgi.agent.inboxPrMerge",
          "when": "false"
        },
        {
          "command": "corgi.agent.inboxPrClose",
          "when": "false"
        },
        {
          "command": "corgi.agent.inboxIgnore",
          "when": "false"
        },
        {
          "command": "corgi.agent.inboxUnblock",
          "when": "false"
        },
        {
          "command": "corgi.agent.inboxAssign",
          "when": "false"
        },
        {
          "command": "corgi.agent.inboxMove",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "corgi",
      "properties": {
        "corgi.sessionTracking": {
          "type": "boolean",
          "default": true,
          "description": "Let `corgi agent` find this window: injects CORGI_VSCODE_WINDOW into integrated terminals and lets `corgi agent focus` (or a Stream Deck) reveal the terminal tab a Claude Code session runs in. Does nothing until corgi agent mode has been used on this machine."
        },
        "corgi.claudePanelCommand": {
          "type": "string",
          "default": "",
          "description": "Command id that focuses the Claude Code extension's panel, used when a tracked session runs in the panel rather than a terminal. Leave empty to try the known ids."
        },
        "corgi.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Command run in the new terminal that `corgi agent new` (a Stream Deck '+' key) opens in this window. Change it to pass flags, e.g. `claude --model opus`."
        },
        "corgi.agentIsolate": {
          "type": "boolean",
          "default": false,
          "description": "Start every session from here in a worktree of its own (corgi agent new / watch work --isolate, corgi 2.20.8+): the branch is corgi/<ticket>, under corgi_services/.worktrees, so two sessions never edit one checkout. `corgi worktree prune` clears the finished ones."
        },
        "corgi.agentStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the corgi agent session board in the status bar: sessions working, sessions that need you, and the tightest 5-hour usage limit. Hidden while the board is empty. Click it to pick a session."
        },
        "corgi.agentToasts": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification with a Go button when a Claude Code session in another window starts waiting for you. Only the focused window shows it."
        },
        "corgi.autoContinue.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Resume a Claude Code session that stopped on a usage limit, the moment its window resets. Corgi sends one message (`corgi.autoContinue.message`) to each limited session. Off by default. What is queued shows in the status bar, and any session can be cancelled from there before it is sent."
        },
        "corgi.autoContinue.message": {
          "type": "string",
          "default": "continue",
          "markdownDescription": "What to type into a session when its limit resets."
        },
        "corgi.autoContinue.graceSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "maximum": 3600,
          "markdownDescription": "Seconds to wait past the reset time before typing. The limit lifts on Anthropic's clock, not this machine's, so a small margin avoids sending into a window that has not opened yet."
        },
        "corgi.watchFixes.statusBar": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show what `corgi agent watch --auto` is working on in the status bar: a spinner while a headless fix runs, then how many pull requests it opened. A fix takes minutes and only speaks when it is over, so without this the editor gives no sign that anything is happening on your behalf."
        },
        "corgi.watchFixes.progress": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Also raise a progress notification for each running fix, and offer to open the pull request when it finishes. Turn this off to keep it to the status bar."
        },
        "corgi.agent.hiddenWorkspaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Workspaces tucked away while this editor is shown to someone: their sessions, inbox items and runs leave the views and the status bar, and nothing about them toasts. By workspace id, session label, or a folder's last path component. Nothing on the machine changes. Right-click a workspace in the sessions view to add one; `Corgi: Hidden workspaces\u2026` to bring them back."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "showcase": "scripts/capture.sh",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "build:vsce": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.95.0",
    "@vscode/test-electron": "^2.3.2",
    "copy-webpack-plugin": "11.0.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1"
  },
  "dependencies": {
    "ajv": "8.12.0",
    "yaml": "2.3.1"
  }
}
